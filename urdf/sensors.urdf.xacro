<?xml version="1.0"?>
<!--
  mando_vision_2026 — 카메라 외부 파라미터
  측정: 2026-09-12, 접지 상태 / 렌즈 광학중심 기준 / 브라켓 우향 보정 이후

  base_link = 후륜축 중심, 지면 높이(z=0).
    ★ 팀 URDF가 base_link를 차축 높이에 두고 있으면 아래 z에서 차축 반경을 뺄 것.
      정의가 섞여도 에러가 안 나고 라이다 융합 때 수직 오프셋으로만 나타남.

  ★ UNVERIFIED = 아직 근거 없음. 확정 전 거리 환산에 쓰지 말 것.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mando_sensors">

  <!-- ================= 전방 D455 (cam_front) ================= -->
  <!-- pitch가 1도 "위"다. 0이 아니다.
       0으로 가정하면 10 m에서 15%, 15 m에서 19% 거리 오차가 나는데 경고가 없다.
       대가로 근거리 지면을 잃는다: 수직 FOV 65도 가정 시 카메라 앞 1.63 m부터 지면이 보임. -->
  <xacro:property name="front_x"     value="0.725"/>
  <xacro:property name="front_y"     value="-0.06"/>     <!-- 운전석 기준 우측 = ROS -y -->
  <xacro:property name="front_z"     value="1.00"/>
  <xacro:property name="front_roll"  value="0.0"/>
  <xacro:property name="front_pitch" value="-0.017453"/> <!-- -1.0 deg (위) -->
  <xacro:property name="front_yaw"   value="0.0"/>       <!-- UNVERIFIED: 브라켓 눈대중 보정만 됨 -->

  <!-- ================= 정지선 C920 (cam_stopline) ================= -->
  <!-- DBD 필터의 taus가 이 z/pitch에 직접 묶여 있다.
       둘 중 하나라도 바뀌면 stopline 파라미터를 반드시 다시 계산할 것. -->
  <xacro:property name="stop_x"      value="0.76"/>
  <xacro:property name="stop_y"      value="-0.06"/>
  <xacro:property name="stop_z"      value="0.83"/>
  <xacro:property name="stop_roll"   value="0.0"/>
  <xacro:property name="stop_pitch"  value="0.488692"/>  <!-- 28.0 deg (아래) -->
  <xacro:property name="stop_yaw"    value="0.0"/>       <!-- UNVERIFIED -->

  <!-- ================= 링크 ================= -->
  <!-- inertial 없음. 이 URDF는 TF/시각화 전용이고 동역학에 안 쓴다. -->

  <link name="cam_front_link"/>
  <link name="cam_stopline_link"/>
  <link name="cam_stopline_optical_frame"/>

  <!-- ================= 조인트 ================= -->

  <joint name="base_to_cam_front" type="fixed">
    <parent link="base_link"/>
    <child  link="cam_front_link"/>
    <origin xyz="${front_x} ${front_y} ${front_z}"
            rpy="${front_roll} ${front_pitch} ${front_yaw}"/>
  </joint>

  <!-- ★ cam_front의 optical frame을 여기서 정의하지 않는다.
       realsense 드라이버가 cam_front_link -> cam_front_color_optical_frame 을
       공장 캘리브레이션 실측 외부파라미터로 직접 발행하기 때문.
       URDF에 추정치를 박으면 그 값이 더 부정확하고, 드라이버 것과 충돌한다.

       전제: cameras.launch에서 드라이버를 camera:=cam_front 로 띄워야
             프레임 이름이 위 링크와 맞물린다. 이름이 어긋나면 TF 트리가
             두 조각으로 끊기는데, 노드는 정상 기동하고 lookup만 조용히 실패한다.

       ★ 검증 필요: front_z=1.00 은 "렌즈 광학중심"까지 잰 값인데,
         D455의 camera_link 원점이 RGB 렌즈인지 depth(좌측 IR)인지 미확인.
         드라이버 띄운 뒤 한 줄로 확인:
           rosrun tf tf_echo cam_front_link cam_front_color_optical_frame
         거기 나오는 translation 만큼 front_z / front_y 를 보정할 것. -->

  <joint name="base_to_cam_stopline" type="fixed">
    <parent link="base_link"/>
    <child  link="cam_stopline_link"/>
    <origin xyz="${stop_x} ${stop_y} ${stop_z}"
            rpy="${stop_roll} ${stop_pitch} ${stop_yaw}"/>
  </joint>

  <!-- C920은 UVC라 외부파라미터를 발행해 줄 드라이버가 없다. 직접 정의한다.
       ROS 광학 규약: z 전방, x 우측, y 하방 -> 본체 프레임에서 (-90, 0, -90).
       위의 stop_pitch를 여기에 또 넣으면 28도가 두 번 적용된다. -->
  <joint name="cam_stopline_to_optical" type="fixed">
    <parent link="cam_stopline_link"/>
    <child  link="cam_stopline_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

</robot>
