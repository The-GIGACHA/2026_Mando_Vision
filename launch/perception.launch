<launch>
  <!-- ═══ 인지 전체 기동 ═══
       roslaunch mando_vision_2026 perception.launch
       roslaunch mando_vision_2026 perception.launch monitor:=false           -->

  <arg name="tf"            default="true"/>
  <arg name="lane"          default="true"/>
  <arg name="traffic_light" default="true"/>
  <arg name="cone"          default="true"/>
  <arg name="delivery_sign" default="false"/>   <!-- 2026 규정에 없음 -->
  <arg name="monitor"       default="true"/>

  <include if="$(arg tf)"            file="$(find mando_vision_2026)/launch/tf.launch"/>
  <include if="$(arg lane)"          file="$(find mando_vision_2026)/launch/lane.launch"/>
  <include if="$(arg traffic_light)" file="$(find mando_vision_2026)/launch/traffic_light.launch"/>
  <include if="$(arg cone)"          file="$(find mando_vision_2026)/launch/cone.launch"/>
  <include if="$(arg delivery_sign)" file="$(find mando_vision_2026)/launch/delivery_sign.launch"/>

  <node if="$(arg monitor)" pkg="mando_vision_2026" type="detection_monitor.py"
        name="detection_monitor" output="screen"/>
</launch>
